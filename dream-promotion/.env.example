# =============================================================================
# Dream Promotion — environment variables
# Copy to .env.local for local work. On Vercel: Settings → Environment Variables.
# Never commit real values.
# =============================================================================

# ------------------------------------------------------------------ SUPABASE --
# Required. Accounts, database, file storage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Storage, final reel, quotas, social tokens. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- TEXT AI --
# Required for anything written by AI (scripts, posts, hashtags, captions polish).
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-6)
AI_MODEL=

# ---------------------------------------------------------- IMAGE + VIDEO AI --
# fal.ai — images (Nano Banana 2), video (Wan), speech-to-text (Whisper) for captions and the mic.
FAL_KEY=
# Optional model overrides (defaults in src/lib/server/ai/config.ts)
FAL_VIDEO_MODEL_T2V=
FAL_VIDEO_MODEL_I2V=
FAL_IMAGE_MODEL=
FAL_IMAGE_EDIT_MODEL=

# Alibaba Cloud Model Studio — Wan text-to-video called directly (written to the official API, not yet
# tested on this account). Leave empty to use fal only.
DASHSCOPE_API_KEY=
# Region of the key: Singapore (default) https://dashscope-intl.aliyuncs.com/api/v1 ·
# Virginia https://dashscope-us.aliyuncs.com/api/v1 · or your workspace domain
DASHSCOPE_BASE_URL=
ALIBABA_WAN_T2V_MODEL=wan2.7-t2v
# fal (default) or alibaba — which provider serves standard / premium clips; the other is the fallback
AI_VIDEO_PRIMARY=fal

# ------------------------------------------------- PRICES (internal cost tracking) --
# USD. Defaults are list prices; empty = unknown (no estimate is stored rather than a guess).
FAL_WAN_USD_PER_SEC_480P=0.05
FAL_WAN_USD_PER_SEC_720P=0.10
FAL_WAN_USD_PER_SEC_1080P=0.20
FAL_IMAGE_USD_EACH=0.08
FAL_WHISPER_USD_PER_MIN=
ALIBABA_WAN_USD_PER_SEC_720P=
ALIBABA_WAN_USD_PER_SEC_1080P=
ANTHROPIC_USD_PER_MTOK_IN=3
ANTHROPIC_USD_PER_MTOK_OUT=15
RENDER_USD_PER_MINUTE=

# --------------------------------------------------------------------- VOICE --
ELEVENLABS_API_KEY=
# Optional
VOICE_PROVIDER=elevenlabs
ELEVENLABS_MODEL_HE=eleven_v3
ELEVENLABS_MODEL=eleven_multilingual_v2
# Your ElevenLabs price per 1,000 characters in USD — internal cost tracking only (empty = unknown)
VOICE_USD_PER_1K_CHARS=

# ---------------------------------------------------------------------- META --
# Facebook Page + Instagram publishing and story import (Meta app → Facebook Login for Business)
META_APP_ID=
META_APP_SECRET=
# Login configuration ids: full = publish + read, read = read only
META_CONFIG_FULL=
META_CONFIG_READ=
META_REDIRECT_URI=https://YOUR-DOMAIN/api/meta/callback
# Optional (default v23.0)
META_GRAPH_VERSION=

# -------------------------------------------------------------------- TIKTOK --
# Uploads go to the creator's TikTok inbox as drafts (they publish from the TikTok app).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR-DOMAIN/api/tiktok/callback
# Optional overrides
TIKTOK_API_BASE=
TIKTOK_AUTH_BASE=

# ------------------------------------------------------------ INTERNAL / CRON --
# Emails (comma separated) that see the internal admin screen /admin: costs, provider health, benchmark.
# Empty = nobody. Checked on the server for every admin request.
ADMIN_EMAILS=
# Shared secret for the story-import timer (Vercel Cron + Supabase pg_cron, see supabase/cron-stories.sql)
CRON_SECRET=
# Encrypts social tokens at rest. SET IT in production: without it the key is derived from SUPABASE_SERVICE_ROLE_KEY,
# and rotating that key makes every saved Meta/TikTok/Tax token unreadable. Changing this one = reconnect every account.
TOKEN_ENCRYPTION_KEY=
# Optional: lets callers without an account use the paid endpoints with this code (header x-access-code)
APP_ACCESS_CODE=
# Extra hosts the server may download media from (comma separated, "*.example.com" allowed).
# Built in: this project's Supabase, *.fal.media, *.fal.ai, *.aliyuncs.com (Alibaba results)
ASSET_HOSTS=
# Optional path to an ffmpeg binary (default: the ffmpeg-static package)
FFMPEG_PATH=
# Optional, shown on the privacy / terms pages
NEXT_PUBLIC_CONTACT_EMAIL=

# ------------------------------------------------------------- LIMITS / QUOTA --
# Monthly per user (0 = unlimited)
QUOTA_VIDEO_SECONDS_MONTH=300
QUOTA_IMAGES_MONTH=200
QUOTA_VOICE_CHARS_MONTH=30000
QUOTA_TRANSCRIBE_MONTH=150
QUOTA_TEXT_CALLS_MONTH=3000
QUOTA_RENDERS_MONTH=300
# Jobs running at once per user, and requests per minute per user (0 = off)
LIMIT_CONCURRENT_VIDEO=3
LIMIT_CONCURRENT_IMAGE=4
LIMIT_CONCURRENT_VOICE=4
LIMIT_PER_MINUTE_VIDEO=10
LIMIT_PER_MINUTE_IMAGE=20
LIMIT_PER_MINUTE_VOICE=40
LIMIT_CONCURRENT_TRANSCRIBE=3
LIMIT_PER_MINUTE_TRANSCRIBE=15
LIMIT_CONCURRENT_TEXT=6
LIMIT_PER_MINUTE_TEXT=30
LIMIT_CONCURRENT_RENDER=1
LIMIT_PER_MINUTE_RENDER=4

# Set automatically by the build / Vercel — do not set by hand:
# NEXT_PUBLIC_APP_VERSION, NEXT_PUBLIC_BUILD_DATE, NEXT_PUBLIC_BUILD_ID, VERCEL_GIT_COMMIT_SHA

# ------------------------------------------------------------ HIGGSFIELD (optional video provider) --
# Wan 3.0 through Higgsfield's official API. Never the default; test it in Admin → provider benchmark first.
# Keys from https://console.higgsfield.ai (server-side only).
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# USD per generated second, from the Higgsfield console price list (no price is assumed without these)
HIGGSFIELD_WAN3_USD_PER_SEC_480P=
HIGGSFIELD_WAN3_USD_PER_SEC_720P=
HIGGSFIELD_WAN3_USD_PER_SEC_1080P=
# AI_VIDEO_PRIMARY=fal | alibaba | higgsfield   (fal stays the fallback)

# ------------------------------------------------------------ TAX AUTHORITY (documents) --
# After the software is registered (see REGISTRATION.md): the 8-digit registration number and the
# vendor's VAT number appear in the unified files (fields 1006, 1009) and on every document.
NEXT_PUBLIC_SOFTWARE_REG_NUMBER=
NEXT_PUBLIC_SOFTWARE_VENDOR_VAT=

# ------------------------------------------------------------ PHONE NOTIFICATIONS (Web Push) --
# A notification on the owner's phone for every sale. Free; on iPhone the app must be added to the home screen.
# Generate once (npx web-push generate-vapid-keys) and set all three on Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ------------------------------------------------------------ DIGITAL SIGNATURE OF DOCUMENTS (2.50) --
# The PDF a customer downloads from their document link is signed with this certificate (PAdES).
# A .p12 / .pfx from a certification authority, base64 of the whole file (base64 -w0 cert.p12), and its password.
# Empty = the PDF is produced unsigned (and says so). See REGISTRATION.md.
DOC_SIGN_P12_BASE64=
DOC_SIGN_P12_PASSWORD=

# ------------------------------------------------------------ FINANCE (2.51) --
# Reading an expense (receipt / invoice photo or PDF) with AI uses ANTHROPIC_API_KEY. Optional model override:
AI_SCAN_MODEL=
# Tax Authority allocation numbers (מספרי הקצאה). Everything below is optional: without it the gateway is
# "unconfigured" and an allocation number received from the Tax Authority is typed in by hand.
# unconfigured (empty) | mock (tests only: TEST-… numbers, refused when VERCEL_ENV=production) | live
# Never set "mock" on a Preview that uses the production database.
TAX_GATEWAY_MODE=
# The app's own address (the OAuth redirect comes back to <APP_URL>/api/finance/tax/callback)
APP_URL=
# Per-business OAuth 2.0 — values from the Tax Authority's developer registration, never invented here
ITA_OAUTH_AUTHORIZE_URL=
ITA_OAUTH_TOKEN_URL=
ITA_CLIENT_ID=
ITA_CLIENT_SECRET=
ITA_OAUTH_SCOPE=
# test | production
ITA_ENVIRONMENT=test
# The allocation API itself (live mode). Requests stop with "spec_not_verified" until the request / response mapping
# is checked against the official specification and this is set to 1.
ITA_API_BASE_URL=
ITA_ALLOCATION_PATH=
ITA_SPEC_VERIFIED=
ITA_TIMEOUT_MS=20000

# ------------------------------------------------------------ STORE: SELLING ON THE SITE (2.56) --
# Seals the business's payment terminal keys (PayPlus) for the storefront, which alone opens them. At least 32 characters,
# the SAME value in the storefront's Vercel project. Not TOKEN_ENCRYPTION_KEY (the storefront never gets that one).
PAYMENT_SEAL_KEY=

# ------------------------------------------------------------ STORE: EVERY STORE'S OWN ADDRESS (2.57.1) --
# <slug>.<STORE_ROOT_DOMAIN> — the root without https:// (e.g. mystores.co.il), the SAME value in the storefront's project,
# and *.<root> added to the storefront's Vercel project (storefront/README.md). Empty: no automatic addresses.
STORE_ROOT_DOMAIN=

# ------------------------------------------------------------ STORE: PAID ORDERS, EMAILS (2.57) --
# The storefront's server tells /api/commerce/finalize that an order was paid. At least 16 characters, the SAME value in the
# storefront's project. (The cron of supabase/cron-commerce.sql uses CRON_SECRET above.)
COMMERCE_SECRET=
# The signed link to an order in a customer's email (/orders/<id>.<mac> on the store's domain). At least 16 characters, the
# SAME value in the storefront's project.
ORDER_LINK_SECRET=
# Resend: the customers' emails (confirmation, shipped, refund). Without it the emails wait in the outbox.
RESEND_API_KEY=
# Optional: the sending address until a store's own domain is verified at Resend (e.g. orders@mail.example.com)
RESEND_FALLBACK_FROM=
