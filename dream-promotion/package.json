  "private": true,
  "scripts": {
    "dev": "next dev",
    "kits": "node scripts/kits.mjs",
    "prebuild": "node scripts/kits.mjs",
    "build": "node node_modules/ffmpeg-static/install.js && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
