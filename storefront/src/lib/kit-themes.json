            "buttonLabel": "לכל השקיות"
          }
        },
        {
          "id": "about",
          "type": "imageText",
          "hidden": false,
          "settings": {
            "title": "למה שקית ממותגת?",
            "text": "שקית עם הלוגו ממשיכה ללכת עם הלקוח גם אחרי הקנייה. היא חלק מהחוויה, והיא מזכירה את העסק בכל מקום שהיא מגיעה אליו.",
            "image": "",
            "buttonLabel": "איך מזמינים",
            "buttonHref": "/pages/how-to-order",
            "imageSide": "start"
          }
        },
        {
          "id": "steps",
          "type": "steps",
          "hidden": false,
          "settings": {
            "title": "איך זה עובד",
            "items": [
              {
                "title": "בוחרים שקית",
                "text": "דגם, מידה וצבע מהקטלוג."
              },
              {
                "title": "שולחים לוגו",
                "text": "קובץ של הלוגו, ואם יש — גם הנחיות להדפסה."
              },
              {
                "title": "מאשרים",
                "text": "מקבלים את כל הפרטים ומאשרים לפני ההדפסה."
              },
              {
                "title": "מקבלים",
                "text": "השקיות מגיעות מודפסות ומוכנות."
              }
            ]
          }
        },
        {
          "id": "faq",
          "type": "faq",
          "hidden": false,
          "settings": {
            "title": "שאלות נפוצות",
            "items": [
              {
                "q": "מה הכמות המינימלית להזמנה?",
                "a": "זה תלוי בדגם ובסוג ההדפסה. כתבו לנו מה אתם צריכים ונחזור עם הפרטים."
              },
              {
                "q": "באיזה קובץ לשלוח את הלוגו?",
                "a": "הכי טוב קובץ וקטורי (PDF, AI או SVG). אם אין — שלחו מה שיש ונבדוק יחד."
              }
            ]
          }
        },
        {
          "id": "contact",
          "type": "contact",
          "hidden": false,
          "settings": {
            "title": "נדבר?",
            "text": "שאלה על דגם, כמויות או הדפסה — כתבו לנו ונחזור אליכם."
          }
        }
      ]
    }
